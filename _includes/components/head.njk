<head>
  <meta charset="utf-8">
  <meta name="generator" content="{{ eleventy.generator }}">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} | Hats by MCK Millinery{% else %}Hats by MCK Millinery | New York and New Orleans{% endif %}</title>
  <meta name="description" content="{{ metaDescription or eleventyComputed.metaDescription or metadata.description }}">
  {% set css %}
    {% include "assets/css/inline.css" %}
  {% endset %}
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ metadata.title }}">
  <meta property="og:title" content="{% if title %}{{ title }} | Hats by MCK Millinery{% else %}Hats by MCK Millinery | New York and New Orleans{% endif %}">
  <meta property="og:description" content="{{ metaDescription or metadata.description }}">
  <meta property="og:url" content="{{ metadata.url }}{{ page.url }}">
  <meta property="og:image" content="{{ metadata.url }}{{ image or '/static/img/hats/mck-millinery-the-coffin-hat.jpg' }}">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{% if title %}{{ title }} | Hats by MCK Millinery{% else %}Hats by MCK Millinery | New York and New Orleans{% endif %}">
  <meta name="twitter:description" content="{{ metaDescription or metadata.description }}">
  <meta name="twitter:image" content="{{ metadata.url }}{{ image or '/static/img/hats/mck-millinery-the-coffin-hat.jpg' }}">

  <link rel="icon" type="image/svg+xml" href="/static/img/logo.svg">
  <link rel="icon" type="image/png" href="/static/img/logo.png">
  <link rel="apple-touch-icon" href="/static/img/logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,700;1,6..96,400&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=EB+Garamond:ital,wght@0,400;0,500;0,700;1,400;1,500;1,700&display=swap" rel="stylesheet">
  <style>{{ css | cssmin | safe }}</style>
  {# Uncomment below if you want to include minified inline JavaScript #}
  {# {% set js %}
    {% include "assets/js/inline.js" %}
  {% endset %}
  <script>{{ js | jsmin | safe }}</script> #}
</head>
